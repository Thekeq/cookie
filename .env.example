# Полный список переменных. Читает их только server/settings.py — если ключа
# нет здесь, значит код его не смотрит. Реальные значения не коммитятся:
# боевой .env лежит в .gitignore.

# ---------- Telegram (обязательно) ----------
BOT_TOKEN = "токен от @BotFather"
ADMIN_ID = 0
BOT_USERNAME = "имя_бота_без_@"
# Short name Mini App из BotFather (/newapp). Пусто — ссылки строятся как
# t.me/<bot>?startapp=..., что работает ТОЛЬКО с включённым Main Mini App
# (BotFather -> Bot Settings -> Configure Mini App). Иначе Telegram
# отвечает BOT_INVALID, и сюда нужно вписать short name приложения.
BOT_APP_NAME = ""
CHANNEL_USERNAME = ""

# ---------- Mini App / HTTP ----------
WEBAPP_URL = "https://твой-домен"
# Хосты, под которыми приложение согласно отвечать (через запятую). Пусто —
# берётся домен из WEBAPP_URL плюс localhost для проверок состояния. Задавать
# отдельно нужно, только если доменов несколько: список ["*"] здесь не
# поддерживается намеренно, он выглядит как защита и ничего не проверяет.
ALLOWED_HOSTS = ""
HOST = "0.0.0.0"
PORT = 8000
# Верить ли заголовку CF-Connecting-IP / X-Forwarded-For при определении IP.
# Боевая схема «игрок -> Cloudflare -> uvicorn»: без него лимитер видит всех
# одним адресом, и один перебор промокодов выжигает анонимный лимит остальным.
# Включать ТОЛЬКО когда до процесса иначе как через Cloudflare не дойти
# (HOST=127.0.0.1 или закрытый файрвол): при открытом наружу порте отправитель
# сам выбирает себе адрес, и лимит по IP не ослабевает, а исчезает совсем.
TRUSTED_PROXY = 0
# DEBUG=1 открывает /docs и /openapi.json — на боевом домене старт отменяется
DEBUG = 0
# TTL подписи initData, сек. Меньше суток ставить нельзя: игрок с открытым
# приложением начнёт получать 401 посреди игры
AUTH_MAX_AGE = 86400

# ---------- Дев-режим ----------
# DEV_MODE=1 заставляет бота присылать ссылку с ГОТОВОЙ подписанной initData.
# На боевом домене это выдача доступа к чужому аккаунту — старт отменяется
DEV_MODE = 0
DEV_URL = "http://127.0.0.1:8000"

# ---------- Хранилища ----------
# SQLite-файл. Заполнен DATABASE_URL — этот ключ игнорируется
DATABASE_PATH = "data.db"
# PostgreSQL: postgresql://user:pass@host:5432/cookie. Только такая схема —
# опечатка вроде sqlite:///data.db тут не «включит SQLite», а уедет в драйвер
# PostgreSQL, поэтому старт на ней отменяется. Перенос данных с файловой базы:
# python migrate_to_postgres.py --sqlite data.db --dry-run
DATABASE_URL = ""
# Redis: redis://localhost:6379/0. Обязателен при WEB_CONCURRENCY > 1 — без
# него лимит запросов становится N-кратным, а фоновые задачи (ролловер сезона,
# бэкап, чистки) запускаются в каждом воркере
REDIS_URL = ""

# ---------- Процессы ----------
# all — API + бот + фоновые задачи в одном процессе (текущий прод)
# api — только HTTP; scheduler — только фоновые задачи (бэкап, чистки, пуши)
# Владельца каждой задачи сторожит планировщик (отметки в таблице job_runs),
# поэтому лишний scheduler не сломает данные — он просто зря потратит процесс.
ROLE = "all"
# polling — один процесс, и только при ROLE=all: разделённые роли поллинг не
# поднимают, апдейты остались бы без читателя. webhook обязателен при
# WEB_CONCURRENCY > 1 (getUpdates отдаёт апдейт ОДНОМУ подписчику, поэтому
# второй воркер не удвоил бы бота, а начал воровать у первого апдейты).
# ВАЖНО: локальная копия на поллинге снимает боевой webhook (delete_webhook), и
# прод замолчит без ошибок в логах. Прод сам вернёт его в течение часа (задача
# webhook_check), но на время дев-сессии бот будет отвечать разработчику.
BOT_MODE = "polling"
# путь, на который Telegram присылает апдейты; тот же домен, что и Mini App
WEBHOOK_PATH = "/tg/webhook"
# внешний https-адрес для setWebhook; пусто — берётся WEBAPP_URL
WEBHOOK_BASE = ""
# секрет заголовка X-Telegram-Bot-Api-Secret-Token: без него апдейты подделает
# кто угодно, включая successful_payment. Пусто — выводится из BOT_TOKEN (у кого
# есть токен, тому секрет уже не нужен)
WEBHOOK_SECRET = ""
# Сколько процессов под API. Больше одного означает: ROLE=api здесь и ОТДЕЛЬНЫЙ
# процесс с ROLE=scheduler (воркеры поднимают только HTTP, фоновых задач у них
# нет), плюс REDIS_URL и BOT_MODE=webhook. Готовые юниты — в deploy/.
WEB_CONCURRENCY = 1

# ---------- Логи и наблюдаемость ----------
LOG_FILE = "cookie.log"
# LOG_JSON=1 — одна строка лога = один JSON-объект (ts/level/logger/msg/role/
# pid/req_id/user_id). На прод обязателен: по тексту «покажи все 500 за час с
# их req_id» не собирается, а при WEB_CONCURRENCY > 1 строки лежат в файле на
# каждый процесс. На дев-машине неудобен, поэтому по умолчанию выключен
LOG_JSON = 0
# Токен ручки /metrics (Authorization: Bearer ...). Пусто — ручки нет вовсе
# (404, а не 401: «сюда нужен пароль» подтверждает, что тут есть что смотреть).
# Короче 16 символов старт отменяется: за метриками видны маршруты, обороты
# валюты и состояние фоновых задач
METRICS_TOKEN = ""
# DSN Sentry. Пусто — трейсбеки только в лог. Задан, а пакета sentry-sdk нет —
# в лог уходит ошибка (иначе опечатка в деплое тихо выключила бы отчёты)
SENTRY_DSN = ""
# Сколько секунд по SIGTERM ждать, пока добьются принятые запросы. Меньше —
# игрок получает обрыв на середине клейма; юниты в deploy/ дают ещё запас
GRACEFUL_TIMEOUT = 20

# ---------- Бэкапы ----------
# Команда, которой снимок уезжает С МАШИНЫ. {src} — полный путь к файлу,
# {name} — имя. Пусто = единственная копия лежит на том же диске, что и база:
# от потери диска это не спасает вовсе. Запускается списком аргументов, без
# оболочки. Примеры:
#   rclone copyto {src} r2:cookie-backups/{name}
#   aws s3 cp {src} s3://cookie-backups/{name}
#   scp {src} backup@другой-хост:/srv/cookie/{name}
BACKUP_UPLOAD_CMD = ""
# Ключ шифрования снимка: 32 байта в base64 (openssl rand -base64 32).
# В снимке лежат user_id, имена и история платежей — чужому хранилищу такое
# отдают только зашифрованным. Хранить НЕ на этом сервере: ключ рядом с
# бэкапом не защищает ни от чего. Потерять ключ = потерять все копии
BACKUP_ENCRYPT_KEY = ""
# Раз во сколько часов проверять бэкап восстановлением (0 — не проверять).
# Проверяются контрольная сумма, расшифровка тем ключом, что в конфиге, и то,
# что база открывается. Всё это ломается молча
BACKUP_DRILL_INTERVAL_H = 24

# ---------- Уведомления ----------
# Аварийный выключатель очереди пушей: 0 возвращает нотификатор к прямому
# проходу по игрокам. Трогать только если очередь сломалась
NOTIFY_QUEUE = 1

# ---------- Канареечная выкладка ----------
# Отдельная полка метрик в Redis для канарейки: лимитер и владение задачами она
# делит с основным парком, а метрики — нет, иначе её пятисотки размываются
# здоровыми процессами и смотреть на выкладку становится не на что.
# Пусто у всех, кроме канареечного юнита (его ставит deploy/canary.py)
METRICS_NAMESPACE = ""
