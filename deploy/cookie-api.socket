[Unit]
# Слушающий порт живёт ОТДЕЛЬНО от процесса, который на нём отвечает.
#
# Зачем. Деплой — это `systemctl restart cookie-api`, то есть две-пять секунд
# без процесса. Раньше в это окно порт был закрыт, соединение получало отказ,
# и игрок видел от Cloudflare 502. Показать вместо этого страницу «идут
# работы» было нечем: своего веб-сервера перед uvicorn в схеме нет.
#
# Теперь порт держит systemd. В окно рестарта соединения копятся в очереди
# ядра (Backlog) и обслуживаются, как только новый процесс их примет. Ошибки
# не возникает вовсе — запрос просто дольше идёт.
#
# Чего это НЕ чинит: деплой, после которого процесс не поднимается совсем.
# Тогда запросы висят до таймаута Cloudflare (100с) и игрок увидит 524 вместо
# 502. Лечится откатом, а не ожиданием, — см. RUNBOOK.
Description=Cookie Merge — слушающий сокет API

[Socket]
# Должно совпадать с HOST/PORT из .env: приложение больше не открывает порт
# само, но settings.PORT читают проверки состояния и канарейка.
ListenStream=0.0.0.0:8000

# Очередь на время рестарта. Дефолтных 128 хватает на обычный трафик, но
# именно в окно деплоя очередь и нужна: всё, что не влезло, получает отказ —
# ровно та ошибка, от которой сокет-юнит и заводится.
Backlog=1024

# Соединение приходит через Cloudflare и несёт один HTTP-запрос за раз;
# ждать досылки данных перед отправкой ответа незачем.
NoDelay=true

# Один процесс на все соединения, а не процесс на соединение (Accept=yes здесь
# был бы копией приложения на КАЖДЫЙ запрос).
Accept=no
Service=cookie-api.service

[Install]
WantedBy=sockets.target
